# Modele de configuration. Copier vers .env.local et renseigner les vraies valeurs.
# Ce fichier ne doit contenir que des valeurs FICTIVES.

# ── Envoi des demandes commerciales Sales (/api/sales-enquiry) ────────────────
# Sans ces six variables, l'API repond 503 et le formulaire affiche un message
# d'indisponibilite. Elle ne renvoie jamais un succes sans envoi reel.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=CHANGEME_smtp_user
SMTP_PASS=CHANGEME_smtp_password
SMTP_FROM_EMAIL=no-reply@example.com
SALES_ENQUIRY_TO_EMAIL=sales@example.com

# ── Formulaire de contact de l'accueil (/api/contact) ─────────────────────────
# Reutilise les memes SMTP_* ci-dessus. Sans CONTACT_TO_EMAIL, l'API repond 503
# et le formulaire affiche une indisponibilite honnete.
CONTACT_TO_EMAIL=office@example.com
